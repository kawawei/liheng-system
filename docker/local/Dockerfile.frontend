# ========================================
# 利恒系統 前端本地開發 Dockerfile
# Liheng System Frontend Local Dev Dockerfile
# ========================================
FROM node:20-alpine

WORKDIR /app/frontend

# 安裝 pnpm 與 curl / wget
RUN npm install -g pnpm@9 && apk add --no-cache curl wget

# 複製前端配置與依賴檔
COPY frontend/package.json frontend/.npmrc* ./

# 獨立安裝前端依賴 (Hoisted 模式，相容 Docker Volume 掛載)
RUN pnpm install

# 複製前端原始碼
COPY frontend/ ./

EXPOSE 5173

# 健康檢查 (Healthcheck) 探針
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5173/ || exit 1

CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]
