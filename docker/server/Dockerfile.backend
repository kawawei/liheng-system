# ========================================
# 利恒系統 後端生產環境 Dockerfile
# Liheng System Backend Server Production Dockerfile
# ========================================
FROM node:20-alpine

WORKDIR /app/backend

ENV NODE_ENV=production

# 安裝 pnpm 與 wget/curl
RUN npm install -g pnpm@9 && apk add --no-cache wget curl

# 複製專案依賴檔與後端原始碼
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY backend/ ./

# 安裝後端依賴 (包含 tsx 執行期)
RUN pnpm install

# 建立上傳與日誌目錄
RUN mkdir -p uploads logs

EXPOSE 8080

# 健康檢查
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

CMD ["pnpm", "start"]
