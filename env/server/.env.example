# ========================================
# 利恒系統 伺服器生產環境變數範本
# Liheng System Server Production Environment Template
# ========================================

# [專案識別]
PROJECT_NAME=liheng-system
NODE_ENV=production

# [網路連接埠]
FRONTEND_PORT=84
BACKEND_PORT=8084
DB_PORT=5435
REDIS_PORT=6382

# [前端 API 網址]
# 若透過網關存取，可設為 /api/v1 或 http://liheng.43.103.3.57.nip.io/api/v1
VITE_API_URL=http://liheng.43.103.3.57.nip.io/api/v1

# [資料庫 PostgreSQL]
DB_USER=liheng_admin
DB_PASSWORD=YOUR_STRONG_RANDOM_DB_PASSWORD
DB_NAME=liheng_production_db

# [快取 Redis]
REDIS_PASSWORD=YOUR_STRONG_RANDOM_REDIS_PASSWORD

# [安全性 JWT]
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET_KEY
CORS_ORIGIN=*
